<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header & Branding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="si firda lovely"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/powered_by"
                    android:textSize="12sp"
                    android:textColor="@color/text_sub" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/accent_primary"
                android:contentDescription="Settings" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Frida Server"
                android:textColor="@color/text_main" />
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Memeriksa environment..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />
        </LinearLayout>

        <!-- Install Frida (hidden until needed) -->
        <Button
            android:id="@+id/btnInstallFrida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Install / Update Frida Server"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent_success"
            android:textAllCaps="false" />

        <!-- Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Application"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_sub"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPackageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pick an app below or type package name"
                android:textSize="14sp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frida Script (.js)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_sub"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etScriptPath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Script path (.js)"
                    android:textSize="14sp"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnPickApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apps"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/accent_success"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnPickFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/accent_primary"
                    android:textAllCaps="false" />
            </LinearLayout>

            <Button
                android:id="@+id/btnScripts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Bundled Scripts"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/accent_primary"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Execution Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnRun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ RUN"
                android:backgroundTint="@color/accent_success"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="■ STOP"
                android:enabled="false"
                android:backgroundTint="@color/accent_danger"
                android:textAllCaps="false"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Session Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@drawable/card_bg"
            app:tabTextColor="@color/text_sub"
            app:tabSelectedTextColor="@color/accent_primary"
            app:tabIndicatorColor="@color/accent_primary"
            app:tabMode="scrollable"
            android:layout_marginTop="12dp" />

        <!-- Terminal Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/terminal_bg"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ TERMINAL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/terminal_foreground"
                android:layout_marginBottom="6dp" />

            <ScrollView
                android:id="@+id/scrollTerminal"
                android:layout_width="match_parent"
                android:layout_height="350dp">

                <TextView
                    android:id="@+id/txtTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/terminal_foreground"
                    android:text="[si firda lovely Console Initialized]\n" />
            </ScrollView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dev_label"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="@color/text_sub" />

    </LinearLayout>
</ScrollView>
